{
  "name": "devhost-monorepo",
  "private": true,
  "version": "0.1.0",
  "description": "devhost: turn an Apple Silicon Mac mini into a headless Claude Code dev server",
  "type": "module",
  "workspaces": [
    "packages/contract",
    "packages/cli"
  ],
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "gen": "npm run gen -w @devhost/contract",
    "build": "tsc -b packages/contract packages/cli",
    "typecheck": "tsc -b packages/contract packages/cli && tsc -p tsconfig.test.json",
    "lint": "eslint .",
    "test": "vitest run",
    "check": "npm run lint && npm run typecheck && npm run test"
  },
  "devDependencies": {
    "@eslint/js": "^9.17.0",
    "@types/node": "^22.10.0",
    "eslint": "^9.17.0",
    "json-schema-to-typescript": "^15.0.3",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.18.0",
    "vitest": "^2.1.8"
  }
}
