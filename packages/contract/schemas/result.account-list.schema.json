{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://devhost.app/schemas/result.account-list.schema.json",
  "title": "AccountListData",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "accounts"
  ],
  "properties": {
    "accounts": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "name",
          "default",
          "configDir",
          "root",
          "portRange",
          "loggedIn",
          "environments"
        ],
        "properties": {
          "name": {
            "type": "string"
          },
          "default": {
            "type": "boolean"
          },
          "configDir": {
            "type": [
              "string",
              "null"
            ]
          },
          "root": {
            "type": "string"
          },
          "portRange": {
            "type": "array",
            "items": {
              "type": "integer"
            },
            "minItems": 2,
            "maxItems": 2
          },
          "loggedIn": {
            "type": [
              "boolean",
              "null"
            ],
            "description": "null when it could not be determined."
          },
          "credentialStore": {
            "type": [
              "string",
              "null"
            ],
            "description": "keychain, file or null when unknown."
          },
          "environments": {
            "type": "integer"
          }
        }
      }
    }
  }
}
