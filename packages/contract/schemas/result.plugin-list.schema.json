{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://devhost.app/schemas/result.plugin-list.schema.json",
  "title": "PluginListData",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "plugins"
  ],
  "properties": {
    "plugins": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "name",
          "builtin",
          "enabled",
          "source",
          "actions",
          "checks"
        ],
        "properties": {
          "name": {
            "type": "string"
          },
          "version": {
            "type": "string"
          },
          "description": {
            "type": "string"
          },
          "builtin": {
            "type": "boolean"
          },
          "enabled": {
            "type": "boolean"
          },
          "source": {
            "type": "string",
            "description": "\"built-in\" or the module's path."
          },
          "error": {
            "type": "string",
            "description": "Why it could not be loaded."
          },
          "actions": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "id",
                "title",
                "description",
                "scope",
                "destructive"
              ],
              "properties": {
                "id": {
                  "type": "string"
                },
                "title": {
                  "type": "string"
                },
                "description": {
                  "type": "string"
                },
                "scope": {
                  "type": "string",
                  "enum": [
                    "host",
                    "environment",
                    "session"
                  ]
                },
                "destructive": {
                  "type": "boolean"
                }
              }
            }
          },
          "checks": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      }
    }
  }
}
