{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://devhost.app/schemas/result.status.schema.json",
  "title": "StatusData",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "version",
    "host",
    "accounts",
    "environments",
    "collector",
    "docker",
    "diskFreePercent"
  ],
  "properties": {
    "version": {
      "type": "string"
    },
    "host": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "tailscale"
      ],
      "properties": {
        "name": {
          "type": "string"
        },
        "tailscale": {
          "type": [
            "object",
            "null"
          ],
          "additionalProperties": false,
          "required": [
            "state",
            "dnsName",
            "ips"
          ],
          "properties": {
            "state": {
              "type": "string"
            },
            "dnsName": {
              "type": [
                "string",
                "null"
              ]
            },
            "ips": {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          }
        }
      }
    },
    "accounts": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "name",
          "default",
          "loggedIn"
        ],
        "properties": {
          "name": {
            "type": "string"
          },
          "default": {
            "type": "boolean"
          },
          "loggedIn": {
            "type": [
              "boolean",
              "null"
            ]
          }
        }
      }
    },
    "environments": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "account",
          "name",
          "service",
          "portBase"
        ],
        "properties": {
          "account": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "service": {
            "type": "string",
            "enum": [
              "running",
              "stopped",
              "not-installed",
              "disabled"
            ]
          },
          "portBase": {
            "type": [
              "integer",
              "null"
            ]
          }
        }
      }
    },
    "collector": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "running",
        "lastSampleAt"
      ],
      "properties": {
        "running": {
          "type": "boolean"
        },
        "lastSampleAt": {
          "type": [
            "integer",
            "null"
          ]
        }
      }
    },
    "docker": {
      "type": "string",
      "enum": [
        "up",
        "down",
        "not-used"
      ]
    },
    "diskFreePercent": {
      "type": [
        "number",
        "null"
      ]
    }
  }
}
