{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://devhost.app/schemas/result.plugin-change.schema.json",
  "title": "PluginChangeData",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "name",
    "action",
    "enabled"
  ],
  "properties": {
    "name": {
      "type": "string"
    },
    "action": {
      "type": "string",
      "enum": [
        "installed",
        "upgraded",
        "uninstalled",
        "enabled",
        "disabled"
      ]
    },
    "enabled": {
      "type": "boolean"
    },
    "url": {
      "type": "string"
    },
    "ref": {
      "type": "string"
    },
    "commit": {
      "type": "string"
    },
    "dryRun": {
      "type": "boolean"
    }
  }
}
