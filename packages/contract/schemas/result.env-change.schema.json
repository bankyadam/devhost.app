{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://devhost.app/schemas/result.env-change.schema.json",
  "title": "EnvChangeData",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "name",
    "action"
  ],
  "properties": {
    "name": {
      "type": "string"
    },
    "account": {
      "type": "string"
    },
    "action": {
      "type": "string",
      "enum": [
        "created",
        "deleted",
        "started",
        "stopped",
        "restarted"
      ]
    },
    "dir": {
      "type": "string"
    },
    "portBase": {
      "type": "integer"
    },
    "steps": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "status"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "status": {
            "type": "string",
            "enum": [
              "ok",
              "changed",
              "skipped",
              "failed"
            ]
          },
          "message": {
            "type": "string"
          }
        }
      }
    },
    "unpushed": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "commits",
        "uncommitted"
      ],
      "properties": {
        "commits": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "uncommitted": {
          "type": "boolean"
        }
      }
    },
    "filesDeleted": {
      "type": "boolean"
    },
    "warnings": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  }
}
