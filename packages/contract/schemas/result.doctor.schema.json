{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://devhost.app/schemas/result.doctor.schema.json",
  "title": "DoctorData",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "ok",
    "summary",
    "checks"
  ],
  "properties": {
    "ok": {
      "type": "boolean",
      "description": "False when any check failed."
    },
    "summary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "ok",
        "warn",
        "fail"
      ],
      "properties": {
        "ok": {
          "type": "integer"
        },
        "warn": {
          "type": "integer"
        },
        "fail": {
          "type": "integer"
        }
      }
    },
    "checks": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "status",
          "message"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "status": {
            "type": "string",
            "enum": [
              "ok",
              "warn",
              "fail"
            ]
          },
          "message": {
            "type": "string"
          },
          "fix": {
            "type": "string",
            "description": "One-line fix; copy-paste ready where possible."
          },
          "advice": {
            "type": "array",
            "description": "Plugins' notes on this check.",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "plugin",
                "message"
              ],
              "properties": {
                "plugin": {
                  "type": "string"
                },
                "message": {
                  "type": "string"
                },
                "fix": {
                  "type": "string",
                  "description": "One-line fix; copy-paste ready."
                },
                "action": {
                  "type": "string",
                  "description": "A host action of this plugin that helps (`devhost plugin run <plugin> <action>`)."
                }
              }
            }
          }
        }
      }
    }
  }
}
