{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://devhost.app/schemas/result.plugin-widgets.schema.json",
  "title": "PluginWidgetsData",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "widgets"
  ],
  "properties": {
    "widgets": {
      "type": "array",
      "description": "Enabled plugins' dashboard cards, in plugin order.",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "plugin",
          "id",
          "title"
        ],
        "properties": {
          "plugin": {
            "type": "string"
          },
          "id": {
            "type": "string"
          },
          "title": {
            "type": "string"
          },
          "status": {
            "type": "string",
            "enum": [
              "ok",
              "warn",
              "fail"
            ]
          },
          "summary": {
            "type": "string",
            "description": "One line under the title."
          },
          "tiles": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "label",
                "value"
              ],
              "properties": {
                "label": {
                  "type": "string"
                },
                "value": {
                  "type": "string"
                },
                "sub": {
                  "type": "string"
                }
              }
            }
          },
          "rows": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "label",
                "value"
              ],
              "properties": {
                "label": {
                  "type": "string"
                },
                "value": {
                  "type": "string"
                },
                "note": {
                  "type": "string"
                }
              }
            }
          },
          "action": {
            "type": "string",
            "description": "A host action of this plugin, offered as a button."
          },
          "error": {
            "type": "string",
            "description": "The widget could not be computed."
          }
        }
      }
    }
  }
}
