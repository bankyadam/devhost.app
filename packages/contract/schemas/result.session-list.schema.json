{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://devhost.app/schemas/result.session-list.schema.json",
  "title": "SessionListData",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "sessions"
  ],
  "properties": {
    "sessions": {
      "type": "array",
      "description": "Newest activity first: the open sessions and those that ended today.",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "account",
          "env",
          "state",
          "startedAt",
          "lastActivityAt",
          "cwd",
          "branch",
          "remoteSession",
          "url"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "account": {
            "type": "string"
          },
          "env": {
            "type": "string"
          },
          "state": {
            "type": "string",
            "enum": [
              "idle",
              "running",
              "waiting",
              "ended"
            ]
          },
          "waitingFor": {
            "type": "string",
            "enum": [
              "permission",
              "question"
            ],
            "description": "Only while waiting, when its notification says what for."
          },
          "startedAt": {
            "type": "integer",
            "description": "Unix ms."
          },
          "lastActivityAt": {
            "type": "integer",
            "description": "Unix ms."
          },
          "cwd": {
            "type": "string"
          },
          "branch": {
            "type": [
              "string",
              "null"
            ],
            "description": "The branch checked out in cwd; null when detached or not a repository."
          },
          "remoteSession": {
            "type": [
              "string",
              "null"
            ],
            "description": "session_… on claude.ai."
          },
          "url": {
            "type": [
              "string",
              "null"
            ],
            "description": "https://claude.ai/code/<remoteSession>"
          }
        }
      }
    }
  }
}
