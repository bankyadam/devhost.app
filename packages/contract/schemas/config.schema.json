{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://devhost.app/schemas/config.schema.json",
  "title": "DevhostConfig",
  "description": "~/.config/devhost/config.yaml (spec A6)",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "machine",
    "notify"
  ],
  "properties": {
    "machine": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "hostname"
      ],
      "properties": {
        "hostname": {
          "type": "string",
          "pattern": "^[A-Za-z0-9]([A-Za-z0-9-]{0,61}[A-Za-z0-9])?$",
          "default": "macmini"
        },
        "rootHelper": {
          "type": "boolean",
          "default": false,
          "description": "Install a root helper that devhost (and the desktop app, over ssh) may run without the sudo password. It only installs, starts and stops devhost's own services, each running as you, and sets the hostname, power and Remote Login settings; installing it asks for the password once. Tailscale's system daemon still asks."
        },
        "power": {
          "type": "object",
          "additionalProperties": false,
          "default": {},
          "properties": {
            "neverSleep": {
              "type": "boolean",
              "default": true
            },
            "autoRestartAfterPowerLoss": {
              "type": "boolean",
              "default": true
            },
            "wakeOnLan": {
              "type": "boolean",
              "default": true
            }
          }
        }
      }
    },
    "storage": {
      "type": "object",
      "additionalProperties": false,
      "default": {},
      "description": "An external work volume for project data (spec A7.12); omit workVolume to keep everything on the internal disk.",
      "properties": {
        "workVolume": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "label",
            "uuid",
            "root"
          ],
          "properties": {
            "label": {
              "type": "string",
              "pattern": "^[A-Za-z0-9][A-Za-z0-9 ._-]{0,62}$",
              "description": "Volume name; mounted at /Volumes/<label>."
            },
            "uuid": {
              "type": "string",
              "pattern": "^[0-9A-Fa-f]{8}-[0-9A-Fa-f]{4}-[0-9A-Fa-f]{4}-[0-9A-Fa-f]{4}-[0-9A-Fa-f]{12}$",
              "description": "APFS volume UUID: the identity check (never the path alone)."
            },
            "encrypted": {
              "type": "boolean",
              "default": false
            },
            "root": {
              "type": "string",
              "pattern": "^/",
              "description": "Account roots default to <root>/<account>; must be on the volume."
            },
            "spotlight": {
              "type": "boolean",
              "default": false,
              "description": "false: Spotlight indexing off on the volume."
            },
            "alerts": {
              "type": "object",
              "additionalProperties": false,
              "default": {},
              "properties": {
                "freePercent": {
                  "type": "number",
                  "minimum": 1,
                  "maximum": 100,
                  "default": 15
                }
              }
            }
          }
        }
      }
    },
    "accounts": {
      "type": "array",
      "default": [],
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "name",
          "root",
          "portRange",
          "git"
        ],
        "properties": {
          "name": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9-]{0,31}$"
          },
          "default": {
            "type": "boolean",
            "default": false
          },
          "configDir": {
            "type": [
              "string",
              "null"
            ],
            "default": null
          },
          "root": {
            "type": "string",
            "minLength": 1
          },
          "portRange": {
            "type": "array",
            "items": [
              {
                "type": "integer",
                "minimum": 1024,
                "maximum": 65535
              },
              {
                "type": "integer",
                "minimum": 1024,
                "maximum": 65535
              }
            ],
            "minItems": 2,
            "maxItems": 2,
            "additionalItems": false
          },
          "git": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "name",
              "email"
            ],
            "properties": {
              "name": {
                "type": "string",
                "minLength": 1
              },
              "email": {
                "type": "string",
                "minLength": 3
              }
            }
          },
          "alerts": {
            "type": "object",
            "additionalProperties": false,
            "default": {},
            "properties": {
              "dailyCostUsd": {
                "type": [
                  "number",
                  "null"
                ],
                "minimum": 0,
                "default": null
              }
            }
          },
          "claudeLogin": {
            "type": [
              "string",
              "null"
            ],
            "default": null,
            "description": "The claude.ai login (email) this account signs in with; recorded at its first `devhost login`. A login as anyone else is refused (signed out again) unless `devhost login <account> --switch-login`."
          },
          "agents": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^[a-z][a-z0-9-]{0,47}$"
            },
            "uniqueItems": true,
            "description": "Agents (subagent definitions) written for the Claude Code sessions here: names from the built-in catalog or from `agents.custom`."
          }
        }
      }
    },
    "environments": {
      "type": "array",
      "default": [],
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "name",
          "account"
        ],
        "properties": {
          "name": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9-]{0,47}$"
          },
          "account": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9-]{0,31}$"
          },
          "repo": {
            "type": "string",
            "minLength": 1
          },
          "portBase": {
            "type": "integer",
            "minimum": 1024,
            "maximum": 65535
          },
          "remoteControl": {
            "type": "object",
            "additionalProperties": false,
            "default": {},
            "properties": {
              "enabled": {
                "type": "boolean",
                "default": true
              },
              "spawn": {
                "type": "string",
                "enum": [
                  "worktree",
                  "same-dir"
                ],
                "default": "worktree"
              },
              "permissionMode": {
                "type": "string",
                "enum": [
                  "default",
                  "acceptEdits",
                  "plan",
                  "auto",
                  "dontAsk",
                  "bypassPermissions"
                ],
                "default": "acceptEdits"
              }
            }
          },
          "compose": {
            "type": "string",
            "enum": [
              "auto",
              "off"
            ],
            "default": "auto"
          },
          "agents": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^[a-z][a-z0-9-]{0,47}$"
            },
            "uniqueItems": true,
            "description": "Agents (subagent definitions) written for the Claude Code sessions here: names from the built-in catalog or from `agents.custom`."
          },
          "alerts": {
            "type": "object",
            "additionalProperties": false,
            "default": {},
            "description": "Estimated cost alerts for this environment (API-equivalent, not billed money); null = no alert.",
            "properties": {
              "dailyCostUsd": {
                "type": [
                  "number",
                  "null"
                ],
                "minimum": 0,
                "default": null,
                "description": "Alert when the environment's estimated cost since local midnight reaches this."
              },
              "hourlyCostUsd": {
                "type": [
                  "number",
                  "null"
                ],
                "minimum": 0,
                "default": null,
                "description": "Alert when the environment's estimated cost over the last 60 minutes reaches this: a session that runs away (a loop, a huge context) shows here first. Clears below 80% of it."
              }
            }
          }
        }
      }
    },
    "packages": {
      "type": "object",
      "additionalProperties": false,
      "default": {},
      "properties": {
        "brew": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "pattern": "^[A-Za-z0-9@._+/-]+$"
          },
          "default": [
            "git",
            "gh",
            "tmux",
            "mosh",
            "direnv",
            "jq",
            "ripgrep",
            "mise"
          ]
        },
        "cask": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "pattern": "^[A-Za-z0-9@._+/-]+$"
          },
          "default": []
        },
        "extra": {
          "type": "array",
          "description": "Raw Brewfile lines appended verbatim.",
          "items": {
            "type": "string"
          },
          "default": []
        }
      }
    },
    "runtimes": {
      "type": "object",
      "description": "Tool name to version, installed via mise.",
      "additionalProperties": {
        "type": "string",
        "minLength": 1
      },
      "default": {
        "node": "lts",
        "python": "3.12",
        "ruby": "3.3",
        "php": "8.3"
      }
    },
    "docker": {
      "type": "object",
      "additionalProperties": false,
      "default": {},
      "properties": {
        "runtime": {
          "type": "string",
          "enum": [
            "colima",
            "orbstack",
            "none"
          ],
          "default": "colima"
        },
        "cpu": {
          "type": "integer",
          "minimum": 1,
          "default": 6
        },
        "memoryGiB": {
          "type": "integer",
          "minimum": 1,
          "default": 16
        },
        "diskGiB": {
          "type": "integer",
          "minimum": 10,
          "default": 200
        },
        "idleSleepMinutes": {
          "type": "integer",
          "minimum": 0,
          "default": 60,
          "description": "Stop an environment's compose services after this many minutes without a session in it, and start them again with the next one (A7.9). 0 turns it off."
        }
      }
    },
    "network": {
      "type": "object",
      "additionalProperties": false,
      "default": {},
      "properties": {
        "tailscale": {
          "type": "boolean",
          "default": true
        },
        "ssh": {
          "type": "boolean",
          "default": true
        }
      }
    },
    "claude": {
      "type": "object",
      "additionalProperties": false,
      "default": {},
      "properties": {
        "install": {
          "type": "string",
          "enum": [
            "brew",
            "native"
          ],
          "default": "brew"
        },
        "settings": {
          "type": "object",
          "description": "Merged into each account's user settings.json.",
          "additionalProperties": true,
          "default": {
            "remoteControlAtStartup": true,
            "inputNeededNotifEnabled": true,
            "agentPushNotifEnabled": true,
            "permissions": {
              "defaultMode": "acceptEdits",
              "ask": [
                "Bash(git commit *)",
                "Bash(git push *)"
              ]
            }
          }
        },
        "update": {
          "type": "string",
          "enum": [
            "auto",
            "notify",
            "off"
          ],
          "default": "auto",
          "description": "Keeping Claude Code current. auto: the collector checks once a day and, inside updateWindow while no session is running a turn, updates it, restarts the Remote Control services and reattaches their open sessions. notify: only tells you an update is there (devhost update does it). off: neither."
        },
        "updateWindow": {
          "type": "string",
          "pattern": "^([01]\\d|2[0-3]):[0-5]\\d-([01]\\d|2[0-3]):[0-5]\\d$",
          "default": "02:00-06:00",
          "description": "Local time range (HH:MM-HH:MM, may wrap midnight) in which the automatic update may run."
        },
        "handoff": {
          "type": "object",
          "additionalProperties": false,
          "default": {},
          "description": "Handoff notes: a session left idle for idleMinutes gets a summary another session can continue from (written by a one-off fork of it; costs about one request over the session's context). Kept in ~/.local/share/devhost/handoff/.",
          "properties": {
            "idleMinutes": {
              "type": "integer",
              "minimum": 0,
              "default": 55,
              "description": "Write the note after this many minutes without activity, just before the prompt cache (1 hour) expires; 0 turns automatic notes off (`devhost session handoff` still works)."
            },
            "minContextTokens": {
              "type": "integer",
              "minimum": 0,
              "default": 50000,
              "description": "Only sessions whose context is at least this large get a note automatically: a small one is cheap to resume."
            }
          }
        }
      }
    },
    "collector": {
      "type": "object",
      "additionalProperties": false,
      "default": {},
      "properties": {
        "port": {
          "type": "integer",
          "minimum": 1024,
          "maximum": 65535,
          "default": 4318
        },
        "sampleIntervalSeconds": {
          "type": "integer",
          "minimum": 1,
          "default": 5
        },
        "retention": {
          "type": "object",
          "additionalProperties": false,
          "default": {},
          "properties": {
            "rawDays": {
              "type": "integer",
              "minimum": 1,
              "default": 7
            },
            "rollupDays": {
              "type": "integer",
              "minimum": 1,
              "default": 365
            },
            "logDays": {
              "type": "integer",
              "minimum": 1,
              "default": 7,
              "description": "Service logs (~/Library/Logs/devhost) are rotated daily and kept compressed this many days; a log nothing wrote to for as long is removed."
            }
          }
        },
        "alerts": {
          "type": "object",
          "additionalProperties": false,
          "default": {},
          "properties": {
            "memoryPercent": {
              "type": "number",
              "minimum": 1,
              "maximum": 100,
              "default": 90
            },
            "diskFreePercent": {
              "type": "number",
              "minimum": 1,
              "maximum": 100,
              "default": 15
            }
          }
        },
        "authCheckMinutes": {
          "type": "integer",
          "minimum": 1,
          "default": 60
        },
        "authProbe": {
          "type": "boolean",
          "description": "Also verify logins with a cheap `claude -p` call (costs a few tokens per check), for the case that `claude auth status` stays green for an expired login.",
          "default": false
        }
      }
    },
    "notify": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "topic"
      ],
      "properties": {
        "provider": {
          "type": "string",
          "enum": [
            "ntfy"
          ],
          "default": "ntfy"
        },
        "topic": {
          "type": "string",
          "minLength": 8
        },
        "server": {
          "type": "string",
          "description": "ntfy server base URL.",
          "default": "https://ntfy.sh"
        }
      }
    },
    "plugins": {
      "type": "object",
      "description": "devhost plugins by name: built-in ones (stats) are on unless enabled is false; one in ~/.config/devhost/plugins/<name>/index.js only with enabled: true.",
      "default": {},
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "enabled": {
            "type": "boolean"
          },
          "options": {
            "type": "object",
            "additionalProperties": true,
            "description": "Passed to the plugin as ctx.options."
          }
        }
      }
    },
    "agents": {
      "type": "object",
      "additionalProperties": false,
      "default": {},
      "properties": {
        "delegation": {
          "type": "boolean",
          "default": false,
          "description": "Add a short rule to the generated CLAUDE.md that tells Claude when to hand work to subagents."
        },
        "custom": {
          "type": "array",
          "default": [],
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "name",
              "description",
              "prompt"
            ],
            "properties": {
              "name": {
                "type": "string",
                "pattern": "^[a-z][a-z0-9-]{0,47}$"
              },
              "description": {
                "type": "string",
                "minLength": 1,
                "description": "When Claude should use the agent."
              },
              "prompt": {
                "type": "string",
                "minLength": 1
              },
              "model": {
                "type": "string"
              },
              "tools": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              }
            }
          }
        }
      }
    }
  }
}
