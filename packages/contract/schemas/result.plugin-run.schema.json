{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://devhost.app/schemas/result.plugin-run.schema.json",
  "title": "PluginRunData",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "plugin",
    "action",
    "dryRun",
    "summary"
  ],
  "properties": {
    "plugin": {
      "type": "string"
    },
    "action": {
      "type": "string"
    },
    "dryRun": {
      "type": "boolean"
    },
    "summary": {
      "type": "string"
    },
    "data": {
      "type": "object",
      "additionalProperties": true,
      "description": "Whatever the action reports, for the app or scripts."
    },
    "plan": {
      "type": "array",
      "description": "With --dry-run: what would run.",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "stepId",
          "action",
          "sudo"
        ],
        "properties": {
          "stepId": {
            "type": "string"
          },
          "action": {
            "type": "string"
          },
          "sudo": {
            "type": "boolean"
          },
          "reason": {
            "type": "string"
          }
        }
      }
    }
  }
}
