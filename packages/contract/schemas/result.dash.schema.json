{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://devhost.app/schemas/result.dash.schema.json",
  "title": "DashData",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "generatedAt",
    "range",
    "host",
    "collector",
    "alerts",
    "accounts",
    "environments",
    "sessions",
    "usage",
    "limits",
    "models"
  ],
  "properties": {
    "generatedAt": {
      "type": "integer",
      "description": "Unix ms."
    },
    "range": {
      "type": "string",
      "enum": [
        "1h",
        "24h",
        "7d",
        "30d"
      ]
    },
    "host": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "online",
        "uptimeSeconds",
        "cpuPercent",
        "memPercent",
        "memTotalBytes",
        "diskFreePercent",
        "diskFreeBytes",
        "docker",
        "tailscale"
      ],
      "properties": {
        "name": {
          "type": "string"
        },
        "online": {
          "type": "boolean",
          "description": "True when the collector sampled in the last minute."
        },
        "uptimeSeconds": {
          "type": [
            "number",
            "null"
          ]
        },
        "cpuPercent": {
          "type": [
            "number",
            "null"
          ]
        },
        "memPercent": {
          "type": [
            "number",
            "null"
          ]
        },
        "memTotalBytes": {
          "type": [
            "number",
            "null"
          ]
        },
        "diskFreePercent": {
          "type": [
            "number",
            "null"
          ]
        },
        "diskFreeBytes": {
          "type": [
            "number",
            "null"
          ]
        },
        "docker": {
          "type": "string",
          "enum": [
            "up",
            "down",
            "unknown"
          ]
        },
        "tailscale": {
          "type": [
            "object",
            "null"
          ],
          "additionalProperties": false,
          "required": [
            "state",
            "dnsName"
          ],
          "properties": {
            "state": {
              "type": "string"
            },
            "dnsName": {
              "type": [
                "string",
                "null"
              ]
            }
          }
        }
      }
    },
    "collector": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "lastSampleAt",
        "lastOtelAt",
        "lastHookAt",
        "dbSizeBytes",
        "schemaVersion"
      ],
      "properties": {
        "lastSampleAt": {
          "type": [
            "integer",
            "null"
          ]
        },
        "lastOtelAt": {
          "type": [
            "integer",
            "null"
          ]
        },
        "lastHookAt": {
          "type": [
            "integer",
            "null"
          ]
        },
        "dbSizeBytes": {
          "type": [
            "integer",
            "null"
          ]
        },
        "schemaVersion": {
          "type": "integer"
        }
      }
    },
    "alerts": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "message",
          "since"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "message": {
            "type": "string"
          },
          "since": {
            "type": "integer"
          }
        }
      }
    },
    "accounts": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "name",
          "loggedIn",
          "lastAuthCheckAt",
          "today",
          "week",
          "dailyCostAlertUsd"
        ],
        "properties": {
          "name": {
            "type": "string"
          },
          "loggedIn": {
            "type": [
              "boolean",
              "null"
            ]
          },
          "lastAuthCheckAt": {
            "type": [
              "integer",
              "null"
            ]
          },
          "today": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "tokens",
              "costUsd"
            ],
            "properties": {
              "tokens": {
                "type": "number"
              },
              "costUsd": {
                "type": "number"
              }
            }
          },
          "week": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "tokens",
              "costUsd"
            ],
            "properties": {
              "tokens": {
                "type": "number"
              },
              "costUsd": {
                "type": "number"
              }
            }
          },
          "dailyCostAlertUsd": {
            "type": [
              "number",
              "null"
            ]
          }
        }
      }
    },
    "environments": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "account",
          "name",
          "service",
          "cpuPercent",
          "rssBytes",
          "containerCpuPercent",
          "containerMemBytes",
          "portBase",
          "diskBytes",
          "activeSessions"
        ],
        "properties": {
          "account": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "service": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "state",
              "pid"
            ],
            "properties": {
              "state": {
                "type": "string",
                "enum": [
                  "running",
                  "stopped",
                  "unknown",
                  "disabled"
                ]
              },
              "pid": {
                "type": [
                  "integer",
                  "null"
                ]
              }
            }
          },
          "cpuPercent": {
            "type": [
              "number",
              "null"
            ]
          },
          "rssBytes": {
            "type": [
              "number",
              "null"
            ]
          },
          "containerCpuPercent": {
            "type": [
              "number",
              "null"
            ]
          },
          "containerMemBytes": {
            "type": [
              "number",
              "null"
            ]
          },
          "portBase": {
            "type": [
              "integer",
              "null"
            ]
          },
          "diskBytes": {
            "type": [
              "number",
              "null"
            ]
          },
          "activeSessions": {
            "type": "integer"
          }
        }
      }
    },
    "sessions": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "account",
          "env",
          "state",
          "startedAt",
          "lastActivityAt",
          "tokensToday",
          "costToday",
          "cpuPercent",
          "rssBytes"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "account": {
            "type": [
              "string",
              "null"
            ]
          },
          "env": {
            "type": [
              "string",
              "null"
            ]
          },
          "state": {
            "type": "string",
            "enum": [
              "running",
              "waiting",
              "idle",
              "ended"
            ]
          },
          "startedAt": {
            "type": "integer"
          },
          "lastActivityAt": {
            "type": "integer"
          },
          "tokensToday": {
            "type": "number"
          },
          "costToday": {
            "type": "number"
          },
          "cpuPercent": {
            "type": [
              "number",
              "null"
            ]
          },
          "rssBytes": {
            "type": [
              "number",
              "null"
            ]
          },
          "title": {
            "type": "string",
            "description": "The session's title (as claude.ai shows it), from its transcript; read when the dashboard is built, never stored."
          },
          "titleFromPrompt": {
            "type": "boolean",
            "description": "True when the transcript has no title (Remote Control sessions keep theirs on claude.ai) and `title` is the last prompt, shortened."
          },
          "subagents": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "running",
              "total",
              "types"
            ],
            "description": "Subagents the session started (SubagentStart/SubagentStop hooks).",
            "properties": {
              "running": {
                "type": "integer"
              },
              "total": {
                "type": "integer"
              },
              "types": {
                "type": "array",
                "items": {
                  "type": "string"
                },
                "description": "Distinct agent types, e.g. Explore."
              }
            }
          },
          "remoteSession": {
            "type": [
              "string",
              "null"
            ],
            "description": "The Remote Control session (session_\u2026) of a session a Remote Control service started in its own worktree; `devhost session reattach` can bring it back after it ended."
          }
        }
      }
    },
    "usage": {
      "type": "array",
      "description": "Time buckets, one row per account and bucket start.",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "ts",
          "account",
          "input",
          "output",
          "cacheRead",
          "cacheCreation",
          "costUsd"
        ],
        "properties": {
          "ts": {
            "type": "integer"
          },
          "account": {
            "type": "string"
          },
          "input": {
            "type": "number"
          },
          "output": {
            "type": "number"
          },
          "cacheRead": {
            "type": "number"
          },
          "cacheCreation": {
            "type": "number"
          },
          "costUsd": {
            "type": "number"
          }
        }
      }
    },
    "limits": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Known limits to show next to the numbers (spec A10.7)."
    },
    "models": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Models seen in the selected range, for the model filter."
    },
    "agents": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "now",
        "peak",
        "buckets"
      ],
      "description": "How many agents worked at once (sampled every few seconds): sessions running a turn plus subagents. For the account filter, else all accounts; the environment filter does not apply.",
      "properties": {
        "now": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "sessions",
            "subagents"
          ],
          "properties": {
            "sessions": {
              "type": "integer"
            },
            "subagents": {
              "type": "integer"
            }
          }
        },
        "peak": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "total",
            "at"
          ],
          "properties": {
            "total": {
              "type": "integer"
            },
            "at": {
              "type": [
                "integer",
                "null"
              ]
            }
          }
        },
        "buckets": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "ts",
              "sessions",
              "subagents",
              "total"
            ],
            "properties": {
              "ts": {
                "type": "integer"
              },
              "sessions": {
                "type": "integer",
                "description": "Most sessions running a turn at once in the bucket."
              },
              "subagents": {
                "type": "integer",
                "description": "Most subagents running at once in the bucket."
              },
              "total": {
                "type": "integer",
                "description": "Most agents (sessions + subagents) at once in the bucket."
              }
            }
          }
        }
      }
    },
    "volume": {
      "type": [
        "object",
        "null"
      ],
      "additionalProperties": false,
      "description": "The work volume (spec A7.12), as the collector last sampled it; null without one.",
      "required": [
        "label",
        "mountPoint",
        "root",
        "ready",
        "mounted",
        "encrypted",
        "locked",
        "totalBytes",
        "freeBytes",
        "freePct",
        "freeLimit"
      ],
      "properties": {
        "label": {
          "type": "string"
        },
        "mountPoint": {
          "type": "string"
        },
        "root": {
          "type": "string"
        },
        "ready": {
          "type": "boolean"
        },
        "mounted": {
          "type": "boolean"
        },
        "encrypted": {
          "type": [
            "boolean",
            "null"
          ]
        },
        "locked": {
          "type": [
            "boolean",
            "null"
          ]
        },
        "totalBytes": {
          "type": [
            "number",
            "null"
          ]
        },
        "freeBytes": {
          "type": [
            "number",
            "null"
          ]
        },
        "freePct": {
          "type": [
            "number",
            "null"
          ]
        },
        "freeLimit": {
          "type": "number"
        },
        "doubleMount": {
          "type": "boolean"
        },
        "strayDirectory": {
          "type": "boolean"
        },
        "sampledAt": {
          "type": "number"
        }
      }
    },
    "updates": {
      "type": [
        "object",
        "null"
      ],
      "additionalProperties": false,
      "required": [
        "checkedAt",
        "claude",
        "packages"
      ],
      "description": "The collector's daily update check (null before the first one).",
      "properties": {
        "checkedAt": {
          "type": "number"
        },
        "claude": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "installed",
            "latest",
            "outdated"
          ],
          "properties": {
            "installed": {
              "type": [
                "string",
                "null"
              ]
            },
            "latest": {
              "type": [
                "string",
                "null"
              ]
            },
            "outdated": {
              "type": "boolean"
            },
            "shadowed": {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          }
        },
        "packages": {
          "type": "integer",
          "description": "Outdated Brewfile packages besides Claude Code."
        },
        "mode": {
          "type": "string",
          "enum": [
            "auto",
            "notify",
            "off"
          ]
        },
        "waiting": {
          "type": "string",
          "description": "Why an automatic update has not run yet (busy sessions, outside the window)."
        },
        "lastUpdate": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "at",
            "ok",
            "message"
          ],
          "properties": {
            "at": {
              "type": "number"
            },
            "ok": {
              "type": "boolean"
            },
            "message": {
              "type": "string"
            }
          }
        }
      }
    },
    "profile": {
      "type": [
        "object",
        "null"
      ],
      "additionalProperties": false,
      "description": "Where agents spent their time in the range, and memory (spec A10.8). Null until the first tool_result event arrives.",
      "required": [
        "since",
        "busyMs",
        "modelMs",
        "localMs",
        "localOnlyMs",
        "networkMs",
        "cpuBoundMs",
        "tools",
        "memory"
      ],
      "properties": {
        "since": {
          "type": "number",
          "description": "When tool runs started to be recorded (ms since epoch); nothing before it counts."
        },
        "busyMs": {
          "type": "number",
          "description": "Time any agent of a session was working (API requests and tools merged per session, summed over sessions)."
        },
        "modelMs": {
          "type": "number",
          "description": "API requests: the model's time, not this host's."
        },
        "localMs": {
          "type": "number",
          "description": "Tools that run on this host (Bash, Read, Edit, Grep\u2026)."
        },
        "localOnlyMs": {
          "type": "number",
          "description": "Local tool time with no API request or network tool running in the same session: what a faster host could shorten."
        },
        "networkMs": {
          "type": "number",
          "description": "Tools waiting on another service (WebFetch, WebSearch, MCP)."
        },
        "cpuBoundMs": {
          "type": [
            "number",
            "null"
          ],
          "description": "The CPU-bound part of localOnlyMs, from the session's process-tree CPU samples (null: no samples then)."
        },
        "tools": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "tool",
              "class",
              "runs",
              "ms"
            ],
            "properties": {
              "tool": {
                "type": "string"
              },
              "class": {
                "type": "string",
                "enum": [
                  "local",
                  "network",
                  "wait",
                  "nested"
                ]
              },
              "runs": {
                "type": "integer"
              },
              "ms": {
                "type": "number",
                "description": "Summed run time (parallel runs each count)."
              }
            }
          }
        },
        "memory": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "sessionPeakBytes",
            "systemPeakPercent",
            "swapPeakBytes",
            "pressureShare"
          ],
          "properties": {
            "sessionPeakBytes": {
              "type": [
                "number",
                "null"
              ],
              "description": "Highest process-tree memory of one session."
            },
            "systemPeakPercent": {
              "type": [
                "number",
                "null"
              ]
            },
            "swapPeakBytes": {
              "type": [
                "number",
                "null"
              ]
            },
            "pressureShare": {
              "type": [
                "number",
                "null"
              ],
              "description": "Share of samples with the kernel's memory pressure at warning or critical (0\u20131)."
            }
          }
        }
      }
    }
  }
}
