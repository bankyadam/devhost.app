{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://devhost.app/schemas/result.env-list.schema.json",
  "title": "EnvListData",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "environments"
  ],
  "properties": {
    "environments": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "name",
          "account",
          "dir",
          "portBase",
          "remoteControl",
          "compose",
          "service"
        ],
        "properties": {
          "name": {
            "type": "string"
          },
          "account": {
            "type": "string"
          },
          "dir": {
            "type": "string"
          },
          "dirExists": {
            "type": "boolean"
          },
          "portBase": {
            "type": [
              "integer",
              "null"
            ]
          },
          "remoteControl": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "enabled",
              "spawn",
              "permissionMode"
            ],
            "properties": {
              "enabled": {
                "type": "boolean"
              },
              "spawn": {
                "type": "string"
              },
              "permissionMode": {
                "type": "string"
              },
              "url": {
                "type": "string",
                "description": "claude.ai/code link of the Remote Control environment (new sessions start there), from the service log; absent until the service printed it."
              }
            }
          },
          "compose": {
            "type": "string"
          },
          "service": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "label",
              "state",
              "pid"
            ],
            "properties": {
              "label": {
                "type": "string"
              },
              "state": {
                "type": "string",
                "enum": [
                  "running",
                  "stopped",
                  "not-installed",
                  "disabled"
                ]
              },
              "pid": {
                "type": [
                  "integer",
                  "null"
                ]
              }
            }
          }
        }
      }
    }
  }
}
