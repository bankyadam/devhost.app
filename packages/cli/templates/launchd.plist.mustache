<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- Generated by devhost. Do not edit: change ~/.config/devhost/config.yaml and run `devhost apply`. -->
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>{{label}}</string>
  <key>UserName</key>
  <string>{{user}}</string>
{{#workingDirectory}}
  <key>WorkingDirectory</key>
  <string>{{workingDirectory}}</string>
{{/workingDirectory}}
  <key>ProgramArguments</key>
  <array>
{{#args}}
    <string>{{.}}</string>
{{/args}}
  </array>
  <key>EnvironmentVariables</key>
  <dict>
{{#env}}
    <key>{{key}}</key>
    <string>{{value}}</string>
{{/env}}
  </dict>
  <key>RunAtLoad</key>
  <true/>
  <key>KeepAlive</key>
  <true/>
  <key>ThrottleInterval</key>
  <integer>{{throttle}}</integer>
</dict>
</plist>
